# QEDRank environment variables.
# Copy to .env.local for `vercel dev`, set them in the Vercel project settings for the deployed
# app, or enter them with masked input:  .\scripts\set-llm-keys.ps1 -Target Vercel -Redeploy
# Never commit real keys. Model ids and endpoints were checked on 2026-10-01.

# ---- Ten model slots (default roster, UI order) -------------------------------------------
# 1  fable           Claude Fable 5.1 · claude-fable-5-1          https://console.anthropic.com/settings/keys
# 2  opus            Claude Opus 5.5 · claude-opus-5-5            (same key)
ANTHROPIC_API_KEY=
# 3  qwen            Qwen3 30B-A3B Instruct · qwen3-30b-a3b-instruct-2507   GWDG Chat AI (AcademicCloud)
# 4  qwen35          Qwen3.5 397B-A17B · qwen3.5-397b-a17b                  (same key)
# 9  glm             GLM-5.3 Flash · glm-5.3-flash                          (same key)
# 10 deepseek_flash  DeepSeek V4 Flash · deepseek-v4-flash-0731             (same key)
#    endpoint https://chat-ai.academiccloud.de/v1   docs https://docs.hpc.gwdg.de/services/ai-services/saia/index.html
#    model list https://docs.hpc.gwdg.de/services/ai-services/chat-ai/models/index.html
#    one key for the four slots (an existing LLAMA_API_KEY is accepted too); enter it with
#    .\scripts\set-llm-keys.ps1 -Target User -Only qwen
GWDG_API_KEY=
# 5  gpt6_astra      GPT-6 Astra · gpt-6-astra                    https://platform.openai.com/api-keys
# 6  gpt6_sol        GPT-6 Sol · gpt-6-sol                        (same key)
# 7  gpt56_terra     GPT-5.6 Terra · gpt-5.6-terra                (same key)
# 8  gpt54           GPT-5.4 · gpt-5.4                            (same key)
OPENAI_API_KEY=

# ---- Per-slot overrides (ID = slot id upper-cased: FABLE, GPT54, GPT6_ASTRA, LLAMA, …) -------
# Key for one slot only (wins over the vendor key), endpoint, model/deployment id, auth header
# ("api-key" for Azure AI Foundry) and reasoning effort. Examples:
# QEDRANK_API_KEY_GPT54=
# QEDRANK_BASEURL_GPT54=https://<resource>.services.ai.azure.com/models
# QEDRANK_MODEL_GPT54=gpt-5.4
# QEDRANK_AUTH_HEADER_GPT54=api-key
# QEDRANK_BASEURL_DEEPSEEK_FLASH=https://api.deepseek.com   # serve the slot from DeepSeek's own API instead of GWDG
# QEDRANK_MODEL_DEEPSEEK_FLASH=deepseek-v4-flash
# QEDRANK_EFFORT_GLM=max
# QEDRANK_EFFORT_FABLE=high
# Roster (comma-separated slot ids, order kept), e.g. only the models you have keys for:
# QEDRANK_MODELS=qwen,qwen35,glm,deepseek_flash
# Private corpus (ProofBench): list only self-hosted slots here and keep privacy.privateCorpus on in
# qedrank.config.json; a hosted slot is then refused before any statement is sent.

# ---- Optional provider slots outside the default roster (QEDRANK_MODELS=… to enable) ------
# Former roster slots (until 2026-10-23): kimi, mistral, llama (GWDG_API_KEY), deepseek (DeepSeek's own API)
# MOONSHOT_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# SILICONFLOW_API_KEY=
# TOGETHER_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
# NVIDIA_API_KEY=
# QEDRANK_CUSTOM_BASE_URL=
# QEDRANK_CUSTOM_MODEL=
# QEDRANK_CUSTOM_API_KEY=
# QEDRANK_CUSTOM_AUTH_HEADER=
# COHERE_API_KEY=

# ---- Corpus access and feedback storage -------------------------------------------------------
# GitHub token for previewing private corpora server-side (see qedrank/README.md before setting it)
# GITHUB_TOKEN=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
