# QEDengine / QEDRank environment variables.
# Copy to .env.local for `vercel dev`, set them in the Vercel project settings for the deployed
# app, or enter them with masked input:  .\scripts\set-llm-keys.ps1 -Target Vercel -Redeploy
# Never commit real keys. Endpoints and models were checked on 2026-10-01.

# ---- Ten model slots (default roster, in order) -------------------------------------------
# 1  Mistral AI · labs-leanstral-2603 (Lean 4 specialist)    https://console.mistral.ai
MISTRAL_API_KEY=
# 2  DeepSeek · deepseek-v4-pro (paid)                       https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 3  OpenRouter · nvidia/nemotron-3-ultra-550b-a55b:free      https://openrouter.ai/keys
OPENROUTER_API_KEY=
# 4  Groq Cloud · openai/gpt-oss-120b                         https://console.groq.com/keys
GROQ_API_KEY=
# 5  SiliconFlow · deepseek-ai/DeepSeek-R1                    https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=
# 6  Custom OpenAI-compatible slot (replaces GitHub Models, retired 2026-07-30)
QEDRANK_CUSTOM_BASE_URL=
QEDRANK_CUSTOM_MODEL=
QEDRANK_CUSTOM_API_KEY=
# "api-key" for Azure AI Foundry; leave empty for "Authorization: Bearer <key>"
QEDRANK_CUSTOM_AUTH_HEADER=
# 7  Together AI · Qwen/Qwen3.8-Flash (paid)                  https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# 8  Google AI Studio · gemini-3.8-flash                      https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 9  Hugging Face · Qwen/Qwen2.5-Coder-32B-Instruct           https://huggingface.co/settings/tokens
HF_TOKEN=
# 10 NVIDIA NIM · deepseek-ai/deepseek-v4.1-flash             https://build.nvidia.com
NVIDIA_API_KEY=

# ---- Optional overrides ----------------------------------------------------------------------
# Roster (comma-separated provider ids, order kept), e.g. to run only free tiers:
# QEDRANK_MODELS=mistral,openrouter,groq,gemini,huggingface,nvidia
# Model or base URL per provider: QEDRANK_MODEL_<ID>, QEDRANK_BASEURL_<ID>, e.g.
# QEDRANK_MODEL_OPENROUTER=qwen/qwen3.8-27b:free
# QEDRANK_MODEL_DEEPSEEK=deepseek-flash

# ---- Optional providers outside the default roster -------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=

# ---- Corpus access and feedback storage -------------------------------------------------------
# GitHub token for previewing private corpora server-side (see qedrank/README.md before setting it)
# GITHUB_TOKEN=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
