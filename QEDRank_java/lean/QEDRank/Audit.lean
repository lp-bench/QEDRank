import Lean

/-!
# QEDRank evaluator commands

These commands are used ONLY by the evaluator (qedrank/lib/lean.js) inside
isolated scratch files. They are never given to models, and model files that
import `QEDRank.Audit` are rejected by the static screen.

Every command prints one machine-readable info line prefixed with `QR_`.
-/

open Lean Meta Elab Command

namespace QEDRank.Audit

private def kindOf : ConstantInfo → String
  | .thmInfo _    => "theorem"
  | .defnInfo _   => "def"
  | .axiomInfo _  => "axiom"
  | .opaqueInfo _ => "opaque"
  | .ctorInfo _   => "ctor"
  | .inductInfo _ => "inductive"
  | .recInfo _    => "rec"
  | .quotInfo _   => "quot"

private def fmtNames (ns : Array Name) : String :=
  String.intercalate "," (ns.toList.map toString)

/-- Is the type of `ci` a proposition? -/
private def isPropType (ci : ConstantInfo) : MetaM Bool := do
  try
    let s ← inferType ci.type
    isDefEq s (mkSort Level.zero)
  catch _ => pure false

/-- `#qr_version` — toolchain string. -/
elab "#qr_version" : command => do
  logInfo m!"QR_VERSION lean={Lean.versionString}"

/-- `#qr_axioms c` — transitive axioms of `c` plus safety flags. -/
elab "#qr_axioms " c:ident : command => do
  let n ← liftCoreM (realizeGlobalConstNoOverload c)
  let env ← getEnv
  let some ci := env.find? n | throwError "QR_ERROR unknown constant {n}"
  let axioms ← collectAxioms n
  let isProp ← liftTermElabM (isPropType ci)
  logInfo m!"QR_AXIOMS name={n} kind={kindOf ci} prop={isProp} unsafe={ci.isUnsafe} partial={ci.isPartial} axioms=[{fmtNames axioms}]"

/-- `#qr_decls Mod` — list the non-internal constants declared in module `Mod`. -/
elab "#qr_decls " m:ident : command => do
  let env ← getEnv
  let some idx := env.getModuleIdx? m.getId
    | throwError "QR_ERROR module not imported: {m.getId}"
  let names := env.header.moduleData[idx.toNat]!.constNames
  let mut count : Nat := 0
  for n in names do
    if n.isInternal then continue
    if let some ci := env.find? n then
      let isProp ← liftTermElabM (isPropType ci)
      count := count + 1
      logInfo m!"QR_DECL module={m.getId} name={n} kind={kindOf ci} prop={isProp} unsafe={ci.isUnsafe}"
  logInfo m!"QR_DECLS_DONE module={m.getId} count={count}"

/-- `#qr_mk_prop P := c` — defines `P : Prop := <type of c>` so that ordinary
tactics can reason about the *statement* of `c` without touching its proof. -/
elab "#qr_mk_prop " p:ident " := " c:ident : command => do
  let n ← liftCoreM (realizeGlobalConstNoOverload c)
  liftTermElabM do
    let ci ← getConstInfo n
    unless (← isPropType ci) do
      throwError "QR_ERROR not a proposition: {n} : {ci.type}"
    addDecl <| .defnDecl {
      name := p.getId, levelParams := ci.levelParams, type := mkSort Level.zero,
      value := ci.type, hints := .abbrev, safety := .safe }
  logInfo m!"QR_MK_PROP name={p.getId} from={n}"

/-- `#qr_compare a b` — structural and definitional comparison of the
statements (types) of `a` and `b`. Nothing about their proofs is inspected. -/
elab "#qr_compare " a:ident b:ident : command => do
  let na ← liftCoreM (realizeGlobalConstNoOverload a)
  let nb ← liftCoreM (realizeGlobalConstNoOverload b)
  liftTermElabM do
    let ca ← getConstInfo na
    let cb ← getConstInfo nb
    let ta := ca.type
    let tb :=
      if ca.levelParams.length == cb.levelParams.length then
        cb.type.instantiateLevelParams cb.levelParams (ca.levelParams.map mkLevelParam)
      else cb.type
    let syn := ta == tb
    let red ← try withReducible (isDefEq ta tb) catch _ => pure false
    let dflt ← try withTransparency .default (isDefEq ta tb) catch _ => pure false
    logInfo m!"QR_COMPARE a={na} b={nb} syntactic={syn} reducible={red} default={dflt}"

/-- `#qr_uses_hyp t` — for `t := fun h => body`, report whether `body` uses `h`.
Used to reject implication "proofs" that never look at their hypothesis.
`t` should be a `def` (theorem values may be elaborated asynchronously). -/
elab "#qr_uses_hyp " t:ident : command => do
  let n ← liftCoreM (realizeGlobalConstNoOverload t)
  let env ← getEnv
  let some ci := env.find? n | throwError "QR_ERROR unknown constant {n}"
  let value? : Option Expr := ci.value? (allowOpaque := true)
  match value? with
  | none => logInfo m!"QR_USES_HYP name={n} uses=unknown reason=no_value"
  | some v =>
    match v with
    | .lam _ _ body _ => logInfo m!"QR_USES_HYP name={n} uses={body.hasLooseBVar 0}"
    | _ => logInfo m!"QR_USES_HYP name={n} uses=unknown reason=not_a_lambda"

/-! ## Grading an agent's solution file against its challenge file -/

/-- The name as the user wrote it: a private name without its module prefix. -/
private def userName (n : Name) : Name := (privateToUserName? n).getD n

/-- Auxiliary declarations (`_proof_1`, `match_1`, `_eq_1`, …) generated by the elaborator. -/
private def isAuxName (n : Name) : Bool := (userName n).isInternal

/-- Every universe level in normal form, so that levels are compared up to equivalence. -/
private def normLevels (e : Expr) : Expr := e.replaceLevel fun l => some l.normalize

/-- Instantiate the universe parameters of `sol` with those of `ref` (same count assumed) and
normalise the levels. The instantiation itself rebuilds levels with `mkLevelMax'`, which
simplifies them (`max 1 (u+1)` becomes `u+1`), so the reference side must be normalised the
same way (`refLevels`): otherwise two identical object files compare as `value_changed`
whenever a value carries such a level (seen on ProofBench P001, `hadwigerNumber`). -/
private def alignLevels (ref sol : ConstantInfo) (e : Expr) : Expr :=
  normLevels (e.instantiateLevelParams sol.levelParams (ref.levelParams.map mkLevelParam))

/-- The reference expression put through the same level treatment as `alignLevels`. -/
private def refLevels (ref : ConstantInfo) (e : Expr) : Expr := alignLevels ref ref e

/-- Compare the reference declaration `ref` with the solution declaration `sol` of the same
name. Expressions are compared up to renaming of bound variables and universe parameters and
up to equivalence of universe levels. The value of a theorem (its proof) is never compared. -/
private def diffConst (ref sol : ConstantInfo) : String :=
  if kindOf ref != kindOf sol then "kind_changed"
  else if ref.levelParams.length != sol.levelParams.length then "levels_changed"
  else if !(refLevels ref ref.type == alignLevels ref sol sol.type) then "type_changed"
  else match ref, sol with
    | .defnInfo a, .defnInfo b =>
      if refLevels ref a.value == alignLevels ref sol b.value && a.safety == b.safety then "same" else "value_changed"
    | .opaqueInfo a, .opaqueInfo b =>
      if refLevels ref a.value == alignLevels ref sol b.value && a.isUnsafe == b.isUnsafe then "same" else "value_changed"
    | .inductInfo a, .inductInfo b =>
      if a.numParams == b.numParams && a.numIndices == b.numIndices && a.all == b.all
          && a.ctors == b.ctors && a.isRec == b.isRec && a.isUnsafe == b.isUnsafe then "same"
      else "value_changed"
    | .ctorInfo a, .ctorInfo b =>
      if a.induct == b.induct && a.cidx == b.cidx && a.numParams == b.numParams
          && a.numFields == b.numFields then "same"
      else "value_changed"
    | _, _ => "same"

/-- `#qr_olean_diff "ref.olean" "sol.olean"` — compare every constant declared in the
challenge object file with the constant of the same name in the solution object file.
Both files must be compiled under the same module name so that private names agree.
Neither file is imported: the declarations are read from the object files as data. -/
elab "#qr_olean_diff " r:str s:str : command => do
  let (refData, _) ← (readModuleData r.getString : IO _)
  let (solData, _) ← (readModuleData s.getString : IO _)
  let mut solMap : Std.HashMap Name ConstantInfo := {}
  for ci in solData.constants do
    solMap := solMap.insert ci.name ci
  let mut same : Nat := 0
  let mut changed : Nat := 0
  let mut missing : Nat := 0
  for ci in refData.constants do
    let status := match solMap[ci.name]? with
      | none => "missing"
      | some sc => diffConst ci sc
    if status == "same" then same := same + 1
    else if status == "missing" then missing := missing + 1
    else changed := changed + 1
    if status != "same" || !isAuxName ci.name then
      logInfo m!"QR_OLEAN_DECL name={ci.name} user={userName ci.name} kind={kindOf ci} aux={isAuxName ci.name} status={status}"
  let refImports := refData.imports.map (·.module)
  let solImports := solData.imports.map (·.module)
  logInfo m!"QR_OLEAN_IMPORTS ref=[{fmtNames refImports}] sol=[{fmtNames solImports}]"
  logInfo m!"QR_OLEAN_DIFF_DONE ref_count={refData.constants.size} sol_count={solData.constants.size} same={same} changed={changed} missing={missing} ref_is_module={refData.isModule} sol_is_module={solData.isModule}"

-- `Environment.replay` is the entry point shared by the toolchains this file supports.
set_option linter.deprecated false in
/-- `#qr_replay "sol.olean"` — send every declaration of the object file to the kernel again,
starting from the environment of the file's imports. This is what `leanchecker` does for one
module; it detects declarations that reached the object file without being type-checked. -/
elab "#qr_replay " s:str : command => do
  let (mod, _) ← (readModuleData s.getString : IO _)
  let failure ← (do
    let env ← importModules mod.imports {} 0
    let mut newConstants : Std.HashMap Name ConstantInfo := {}
    for ci in mod.constants do
      newConstants := newConstants.insert ci.name ci
    try
      discard <| env.replay newConstants
      pure none
    catch e => pure (some (toString e)) : IO (Option String))
  match failure with
  | none => logInfo m!"QR_REPLAY status=passed count={mod.constants.size}"
  | some msg =>
    logInfo m!"QR_REPLAY status=failed count={mod.constants.size}"
    logInfo m!"QR_REPLAY_ERROR {msg}"

/-- `#qr_module_report t Mod` — for every user-written constant declared in module `Mod`:
does it depend on `sorry` (transitively), does its own proof contain `sorry` (directly or
through its auxiliary declarations), does it depend only on the standard axioms, and is it
used (transitively, through declarations of `Mod`) by the target `t`. -/
elab "#qr_module_report " t:ident m:ident : command => do
  let target ← liftCoreM (realizeGlobalConstNoOverload t)
  let env ← getEnv
  let some idx := env.getModuleIdx? m.getId
    | throwError "QR_ERROR module not imported: {m.getId}"
  let names := env.header.moduleData[idx.toNat]!.constNames
  let mut isLocal : NameSet := {}
  for n in names do
    isLocal := isLocal.insert n
  -- Declarations of the module reachable from the target.
  let mut used : NameSet := {}
  let mut todo : Array Name := #[target]
  while todo.size > 0 do
    let n := todo.back!
    todo := todo.pop
    if used.contains n then continue
    used := used.insert n
    if let some ci := env.find? n then
      for d in ci.getUsedConstantsAsSet do
        if isLocal.contains d && !used.contains d then
          todo := todo.push d
  let standard : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut total : Nat := 0
  for n in names do
    if isAuxName n then continue
    let some ci := env.find? n | continue
    let axioms ← collectAxioms n
    let sorryFree := !axioms.contains ``sorryAx
    let axiomsOk := axioms.all fun a => standard.contains a
    -- `sorry` in this declaration's own body, followed through its auxiliary declarations only.
    let mut ownSorry := false
    let mut seen : NameSet := {}
    let mut stack : Array Name := #[n]
    while stack.size > 0 do
      let c := stack.back!
      stack := stack.pop
      if seen.contains c then continue
      seen := seen.insert c
      if let some cc := env.find? c then
        let deps := match cc.value? (allowOpaque := true) with
          | some v => v.getUsedConstantsAsSet
          | none => {}
        if deps.contains ``sorryAx then ownSorry := true
        for d in deps do
          if isLocal.contains d && isAuxName d && !seen.contains d then
            stack := stack.push d
    total := total + 1
    logInfo m!"QR_MODULE_DECL name={n} user={userName n} kind={kindOf ci} target={n == target} used={used.contains n} sorry_free={sorryFree} own_sorry={ownSorry} axioms_ok={axiomsOk}"
  logInfo m!"QR_MODULE_REPORT_DONE module={m.getId} target={target} count={total}"

end QEDRank.Audit
